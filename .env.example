# Copy to `.env` and fill in whichever provider(s) you want.
# Dev mode auto-loads this file; packaged builds use the Settings page instead.

# Gemini 2.5 Flash is free. Get a key from AI Studio (NOT Vertex AI):
#   https://aistudio.google.com/apikey
# The app targets the Gemini Developer API at
# https://generativelanguage.googleapis.com/v1beta — a Vertex service account
# will NOT work here.
GEMINI_API_KEY=

# Optional fallbacks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
