# Copy to `.env` and fill in whichever provider(s) you want.
# Dev mode auto-loads this file; packaged builds use Settings instead.

# Simplest paid path — one key for Claude, GPT, Gemini, and more:
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Instructor typical cloud (attendees: Ollama or free Groq/Gemini).
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Free cloud backups (rate limits apply).
#   https://console.groq.com/keys
GROQ_API_KEY=
#   https://aistudio.google.com/apikey  (AI Studio — NOT Vertex)
GEMINI_API_KEY=
